# Copy to `.env.local` for development. Committed as a template.
# Deliberately no NEXT_PUBLIC_ variables: under the BFF the browser talks only to
# this Next origin and must never learn the API's.

API_BASE_URL=http://localhost:4100

# In production use the __Host- prefixed name, which browsers only accept over
# HTTPS with Path=/ and no Domain attribute:
#   SESSION_COOKIE_NAME=__Host-ylj_session
SESSION_COOKIE_NAME=ylj_session

# Whether /book offers a pay button. Presence is the switch: set it and the flow
# takes payments, leave it blank and the flow renders with the pay step disabled
# and an explanation.
#
# Still not a NEXT_PUBLIC_ variable, deliberately — it's read on the server and
# passed down as a prop. The key Stripe.js is actually mounted with comes from the
# API alongside the Checkout Session's client secret, so the session and the key
# can never name different accounts. This one only decides whether to offer the
# button, so it just needs to match the API's mode (test with test, live with live).
STRIPE_PUBLISHABLE_KEY=
