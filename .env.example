# Copy to `.env.local` for development. Committed as a template.
# Deliberately no NEXT_PUBLIC_ variables: under the BFF the browser talks only to
# this Next origin and must never learn the API's.

API_BASE_URL=http://localhost:4100

# In production use the __Host- prefixed name, which browsers only accept over
# HTTPS with Path=/ and no Domain attribute:
#   SESSION_COOKIE_NAME=__Host-ylj_session
SESSION_COOKIE_NAME=ylj_session
