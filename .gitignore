# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Contracts copied from ../server by scripts/sync-contracts.mjs.
#
# Deliberately COMMITTED, not ignored: the API is a separate repository, and CI and
# Vercel clone only this one — with nothing to copy from, the build has to use
# what's in the tree. Ignoring these is what broke the first preview deployment.
#
# The originals in server/src/contracts remain the source of truth. predev and
# prebuild regenerate them whenever the sibling checkout exists, so a stale commit
# shows up as a git diff rather than silently drifting.

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never get committed, but the template must be, so a
# fresh clone can see which variables the app needs.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
